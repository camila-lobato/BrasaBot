@model BrasaBot.ViewModels.EstoqueIndexViewModel

@{
    ViewData["Title"] = "Estoque";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Estoque</h2>
        <small class="text-muted">Gerencie o estoque.</small>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Botão Registrar Movimentação -->
<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#modalMovimentacao">
        <i class="bi bi-arrow-left-right"></i> Registrar Movimentação
    </button>
</div>

<!-- Painel de Estoque Baixo -->
@if (Model.InsumosBaixos.Any())
{
    <div class="alert alert-danger mb-4">
        <h6 class="mb-3"><i class="bi bi-exclamation-triangle"></i> Estoque Baixo</h6>
        <div class="row g-2">
            @foreach (var insumo in Model.InsumosBaixos)
            {
                <div class="col-md-4">
                    <div class="card border-danger p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@insumo.Nome</strong>
                            <span class="badge bg-danger">BAIXO</span>
                        </div>
                        <small class="text-muted">
                            Atual: @insumo.EstoqueAtualQtd @insumo.UnidadeMedida
                            (Mín: @insumo.EstoqueMinimo)
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="row g-3">
    <!-- Grade de insumos -->
    <div class="col-md-8">
        <div class="card p-3">
            <h6 class="mb-3">Insumos em Estoque</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Estoque Atual</th>
                            <th>Estoque Anterior</th>
                            <th>Qtd. Mínima</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Insumos.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Nenhum insumo cadastrado.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Insumos)
                            {
                                <tr>
                                    <td>@item.Insumo.Id</td>
                                    <td>@item.Insumo.Nome</td>
                                    <td>@item.Insumo.EstoqueAtualQtd @item.Insumo.UnidadeMedida</td>
                                    <td class="text-muted">@item.EstoqueAnterior @item.Insumo.UnidadeMedida</td>
                                    <td>@item.Insumo.EstoqueMinimo @item.Insumo.UnidadeMedida</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Painel de histórico -->
    <div class="col-md-4">
        <div class="card p-3">
            <h6 class="mb-3">Histórico de Movimentações</h6>
            <div style="max-height: 500px; overflow-y: auto;">
                @if (!Model.Movimentacoes.Any())
                {
                    <p class="text-muted small">Nenhuma movimentação registrada.</p>
                }
                else
                {
                    @foreach (var mov in Model.Movimentacoes)
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@mov.Insumo?.Nome</strong>
                                <span class="small @(mov.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                    @(mov.Tipo == "Entrada" ? "+" : "-")@mov.Quantidade
                                </span>
                            </div>
                            <small class="text-muted">
                                @mov.DataHora.ToString("dd/MM/yyyy HH:mm") — @mov.Funcionario?.Nome
                            </small>
                            @if (!string.IsNullOrEmpty(mov.Observacao))
                            {
                                <div class="small text-muted fst-italic">@mov.Observacao</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Registrar Movimentação -->
<div class="modal fade" id="modalMovimentacao" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Movimentação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tipo de Movimentação</label>
                        <select name="Tipo" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            <option value="Entrada">Entrada</option>
                            <option value="Saida">Saída</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Insumo</label>
                        <select name="InsumoId" asp-items="Model.InsumosSelectList" class="form-select" required>
                            <option value="">-- Selecione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantidade</label>
                        <input name="Quantidade" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observações</label>
                        <textarea name="Observacao" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>