@model BrasaBot.Models.Funcionario

@{
    ViewData["Title"] = "Visualizar Funcionário";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Visualizar Funcionário</h2>
        <small class="text-muted">Gerencie os cadastros de funcionários.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="card p-4">
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <input class="form-control" value="@Model.Id" disabled />
        </div>
        <div class="col-md-10">
            <label class="form-label">Nome</label>
            <input class="form-control" value="@Model.Nome" disabled />
        </div>

        <div class="col-md-6">
            <label class="form-label">Telefone</label>
            <input class="form-control" value="@Model.Telefone" disabled />
        </div>
        <div class="col-md-6">
            <label class="form-label">CPF</label>
            <input class="form-control" value="@Model.CPF" disabled />
        </div>

        <div class="col-12 mt-3">
            <h6>Endereço</h6>
            <hr />
        </div>

        <div class="col-md-6">
            <label class="form-label">Logradouro</label>
            <input class="form-control" value="@Model.Logradouro" disabled />
        </div>
        <div class="col-md-2">
            <label class="form-label">Número</label>
            <input class="form-control" value="@Model.Numero" disabled />
        </div>
        <div class="col-md-4">
            <label class="form-label">Bairro</label>
            <input class="form-control" value="@Model.Bairro" disabled />
        </div>
        <div class="col-md-4">
            <label class="form-label">CEP</label>
            <input class="form-control" value="@Model.CEP" disabled />
        </div>

        <div class="col-12 mt-3">
            <h6>Admissão</h6>
            <hr />
        </div>

        <div class="col-md-6">
            <label class="form-label">Cargo</label>
            <input class="form-control" value="@Model.Cargo" disabled />
        </div>
        <div class="col-md-6">
            <label class="form-label">Data de Admissão</label>
            <input class="form-control" value="@Model.DataAdmissao.ToString("dd/MM/yyyy")" disabled />
        </div>
    </div>
</div>