@model BrasaBot.ViewModels.ProdutoViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Editar Produto</h2>
        <small class="text-muted">Gerencie os cadastros de produtos.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-4">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="FotoAtual" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <!-- Linha 1: ID + Nome + Foto Atual -->
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <input class="form-control" value="@Model.Id" disabled />
        </div>
        <div class="col-md-7">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Foto Atual</label>
            <div>
                <img src="@(string.IsNullOrEmpty(Model.FotoAtual) ? "/img/produto-padrao.png" : Model.FotoAtual)"
                     alt="Foto do produto"
                     style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px;" />
            </div>
        </div>

        <!-- Linha 2: Valor + Categoria -->
        <div class="col-md-4">
            <label asp-for="Valor" class="form-label"></label>
            <input asp-for="Valor" type="text" class="form-control mask-money" data-val="false" />
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                <option value="">-- Selecione uma opção --</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>

        <!-- === INSUMOS (largura total, fora das colunas) === -->
        <div class="col-12 mt-4">
            <h6>Insumos utilizados</h6>
            <hr />
        </div>

        <div class="col-12">
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Insumo</label>
                    <select id="selectInsumo" class="form-select" asp-items="Model.InsumosDisponiveis">
                        <option value="">-- Selecione um insumo --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Quantidade</label>
                    <input id="inputQuantidade" type="number" step="0.01" class="form-control" placeholder="Quantidade" />
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnAdicionarInsumo" class="btn btn-dark w-100">
                        <i class="bi bi-plus-lg"></i> Adicionar
                    </button>
                </div>
            </div>

            <table class="table table-sm table-bordered align-middle" id="tabelaInsumos">
                <thead class="table-light">
                    <tr>
                        <th>Insumo</th>
                        <th style="width: 150px;">Quantidade</th>
                        <th style="width: 100px;">Unidade</th>
                        <th class="text-center" style="width: 80px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.InsumosSelecionados != null)
                    {
                        for (int i = 0; i < Model.InsumosSelecionados.Count; i++)
                        {
                            var item = Model.InsumosSelecionados[i];
                            <tr data-insumoid="@item.InsumoId">
                                <td>
                                    @item.InsumoNome
                                    <input type="hidden" name="InsumosSelecionados[@i].InsumoId" value="@item.InsumoId" />
                                    <input type="hidden" name="InsumosSelecionados[@i].InsumoNome" value="@item.InsumoNome" />
                                    <input type="hidden" name="InsumosSelecionados[@i].Unidade" value="@item.Unidade" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="InsumosSelecionados[@i].Quantidade"
                                           value="@item.Quantidade" class="form-control form-control-sm" />
                                </td>
                                <td>@item.Unidade</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remover-insumo">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Linha 3: Foto + Ativo -->
        <div class="col-md-6 mt-4">
            <label asp-for="ArquivoFoto" class="form-label">Alterar Foto</label>
            <input asp-for="ArquivoFoto" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
            <span asp-validation-for="ArquivoFoto" class="text-danger"></span>
            <small class="text-muted">Deixe em branco para manter a foto atual.</small>
        </div>
        <div class="col-md-6 mt-4">
            <label asp-for="Ativo" class="form-label"></label>
            <select asp-for="Ativo" class="form-select">
                <option value="true">Sim</option>
                <option value="false">Não</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-dark">
            <i class="bi bi-check-lg"></i> Confirmar
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            var index = @(Model.InsumosSelecionados?.Count ?? 0);

            $('#btnAdicionarInsumo').on('click', function () {
                var insumoId = $('#selectInsumo').val();
                var textoCompleto = $('#selectInsumo option:selected').text();
                var match = textoCompleto.match(/^(.+?)\s*\(([^)]+)\)$/);
                if (!match) {
                    alert('Selecione um insumo válido.');
                    return;
                }
                var insumoNome = match[1].trim();
                var unidade = match[2].trim();
                var quantidade = parseFloat($('#inputQuantidade').val());

                if (!insumoId || !quantidade || quantidade <= 0) {
                    alert('Selecione um insumo e uma quantidade válida.');
                    return;
                }

                var jaExiste = false;
                $('#tabelaInsumos tbody tr').each(function () {
                    if ($(this).data('insumoid') == insumoId) jaExiste = true;
                });
                if (jaExiste) {
                    alert('Este insumo já foi adicionado. Remova antes de adicionar novamente.');
                    return;
                }

                var linha = `
                    <tr data-insumoid="${insumoId}">
                        <td>${insumoNome}
                            <input type="hidden" name="InsumosSelecionados[${index}].InsumoId" value="${insumoId}" />
                            <input type="hidden" name="InsumosSelecionados[${index}].InsumoNome" value="${insumoNome}" />
                            <input type="hidden" name="InsumosSelecionados[${index}].Unidade" value="${unidade}" />
                        </td>
                        <td>
                            <input type="number" step="0.01" name="InsumosSelecionados[${index}].Quantidade"
                                   value="${quantidade}" class="form-control form-control-sm" />
                        </td>
                        <td>${unidade}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remover-insumo">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                `;

                $('#tabelaInsumos tbody').append(linha);
                index++;
                $('#selectInsumo').val('');
                $('#inputQuantidade').val('');
            });

            $(document).on('click', '.btn-remover-insumo', function () {
                $(this).closest('tr').remove();
            });
        });
    </script>
}