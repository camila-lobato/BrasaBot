@model BrasaBot.ViewModels.RelatorioIndexViewModel
@{
    ViewData["Title"] = "Relatórios";
}

@Html.AntiForgeryToken()

<div class="mb-3">
    <h2 class="mb-0">Relatórios</h2>
    <small class="text-muted">Analise o desempenho do restaurante.</small>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Cartões de relatórios -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Vendas">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-file-earmark-text text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório de Vendas</div>
                    <small class="text-muted">Vendas por período</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Caixa">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-cash text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório de Caixa</div>
                    <small class="text-muted">Movimentações de caixa</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Despesas">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-receipt text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório de Despesas</div>
                    <small class="text-muted">Despesas pagas e a pagar</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Financeiro">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-graph-up text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório Financeiro</div>
                    <small class="text-muted">Faturamento, custos e lucro</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Produtos">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-box text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório de Produtos</div>
                    <small class="text-muted">Produtos mais vendidos</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 shadow-sm relatorio-card" data-relatorio="Estoque">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2" style="background-color: #1B2E21;">
                    <i class="bi bi-box-seam text-white"></i>
                </div>
                <div>
                    <div class="fw-bold">Relatório de Estoque</div>
                    <small class="text-muted">Movimentações de estoque</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Data Inicial</label>
            <input type="date" id="dataInicial" class="form-control" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Data Final</label>
            <input type="date" id="dataFinal" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Filtro</label>
            <select id="filtro" class="form-select">
                <option value="Todos">Todos</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="button" id="btnEmitir" class="btn btn-dark w-100" disabled>
                <i class="bi bi-file-earmark-text"></i> Emitir Relatório
            </button>
        </div>
    </div>
</div>

<!-- Histórico -->
<div class="card p-3">
    <h6 class="mb-3">Últimos Relatórios Emitidos</h6>
    @if (!Model.Historico.Any())
    {
        <p class="text-muted small mb-0">Nenhum relatório emitido ainda.</p>
    }
    else
    {
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tipo</th>
                    <th>Usuário</th>
                    <th>Data/Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Historico)
                {
                    <tr>
                        <td>@h.TipoRelatorio</td>
                        <td>@(h.Usuario?.Funcionario?.Nome ?? "-")</td>
                        <td>@h.DataEmissao.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Modal de Pré-visualização -->
<div class="modal fade" id="modalRelatorio" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body" id="corpoRelatorio">
                <div class="text-center py-5">
                    <div class="spinner-border text-dark"></div>
                    <p class="mt-3">Gerando relatório...</p>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-dark" id="btnImprimir">
                    <i class="bi bi-printer"></i> Imprimir
                </button>
                <button type="button" class="btn btn-dark" id="btnExportarPdf">
                    <i class="bi bi-file-earmark-pdf"></i> Exportar em PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var cartoes = document.querySelectorAll('.relatorio-card');
            var modalElemento = document.getElementById('modalRelatorio');
            var corpoRelatorio = document.getElementById('corpoRelatorio');
            var btnImprimir = document.getElementById('btnImprimir');
            var btnEmitir = document.getElementById('btnEmitir');
            var btnExportarPdf = document.getElementById('btnExportarPdf');
            var selectFiltro = document.getElementById('filtro');

            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            var tipoSelecionado = 'Vendas';

            var filtrosPorTipo = {
                'Vendas': ['Todos', 'Mesa', 'Delivery', 'Balcão'],
                'Caixa': ['Todos', 'Entrada', 'Saida'],
                'Despesas': ['Todos', 'A Pagar', 'Pago'],
                'Financeiro': ['Todos'],
                'Produtos': ['Todos', 'Mais Vendidos', 'Menos Vendidos'],
                'Estoque': ['Todos', 'Estoque Baixo']
            };

            cartoes.forEach(function (cartao) {
                if (cartao.classList.contains('disabled')) return;

                cartao.addEventListener('click', function () {
                    cartoes.forEach(function (c) {
                        c.classList.remove('selecionado');
                    });

                    cartao.classList.add('selecionado');
                    tipoSelecionado = cartao.getAttribute('data-relatorio');

                    selectFiltro.innerHTML = '';
                    var opcoes = filtrosPorTipo[tipoSelecionado] || ['Todos'];
                    opcoes.forEach(function (opcao) {
                        var opt = document.createElement('option');
                        opt.value = opcao;
                        opt.textContent = opcao;
                        selectFiltro.appendChild(opt);
                    });

                    btnEmitir.disabled = false;
                });
            });

            btnEmitir.addEventListener('click', function () {
                if (!tipoSelecionado) return;

                var dataInicial = document.getElementById('dataInicial').value;
                var dataFinal = document.getElementById('dataFinal').value;
                var filtro = selectFiltro.value;

                corpoRelatorio.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-dark"></div><p class="mt-3">Gerando relatorio...</p></div>';

                var modal = bootstrap.Modal.getOrCreateInstance(modalElemento);
                modal.show();

                fetch('/Relatorio/Emitir' + tipoSelecionado, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: 'dataInicial=' + encodeURIComponent(dataInicial)
                        + '&dataFinal=' + encodeURIComponent(dataFinal)
                        + '&filtro=' + encodeURIComponent(filtro)
                        + '&__RequestVerificationToken=' + encodeURIComponent(token)
                })
                .then(function (response) {
                    if (!response.ok) throw new Error('Erro HTTP ' + response.status);
                    return response.text();
                })
                .then(function (html) {
                    corpoRelatorio.innerHTML = html;
                })
                .catch(function (erro) {
                    corpoRelatorio.innerHTML = '<div class="alert alert-danger">Erro ao gerar o relatorio: ' + erro.message + '</div>';
                });
            });

            btnImprimir.addEventListener('click', function () {
                var conteudo = corpoRelatorio.innerHTML;
                var janela = window.open('', '', 'height=800,width=1000');
                janela.document.open();
                janela.document.write('<!DOCTYPE html><html><head><title>Relatorio</title>');
                janela.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
                janela.document.write('</head><body>' + conteudo);
                janela.document.write('<\/body><\/html>');
                janela.document.close();
                setTimeout(function () { janela.print(); }, 300);
            });

            btnExportarPdf.addEventListener('click', function () {
                var elemento = document.getElementById('corpoRelatorio');
                var opcoes = {
                    margin: [10, 10, 10, 10],
                    filename: 'relatorio_' + tipoSelecionado + '_' + new Date().getTime() + '.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };
                html2pdf().set(opcoes).from(elemento).save();
            });

            // Marca "Vendas" como selecionado por padrão
            var cardVendas = document.querySelector('.relatorio-card[data-relatorio="Vendas"]:not(.disabled)');
            if (cardVendas) {
                cardVendas.click();
            }
        });
    </script>
}