@model BrasaBot.ViewModels.RelatorioEstoqueViewModel

<div class="relatorio-impressao">
    <div class="mb-4">
        <h5 class="mb-1">Relatório de Estoque</h5>
        <small class="text-muted">
            Emitido em: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") |
            Filtro: @Model.Filtro |
            Usuário: @Model.UsuarioEmissor
        </small>
    </div>

    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Insumo</th>
                <th>Unidade</th>
                <th class="text-end">Est. Atual</th>
                <th class="text-end">Mínimo</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Itens.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">Nenhum insumo cadastrado.</td></tr>
            }
            else
            {
                foreach (var i in Model.Itens)
                {
                    <tr>
                        <td>@i.Insumo</td>
                        <td>@i.Unidade</td>
                        <td class="text-end">@i.EstoqueAtual.ToString("0.##")</td>
                        <td class="text-end">@i.EstoqueMinimo.ToString("0.##")</td>
                        <td>
                            @if (i.Status == "Baixo")
                            {
                                <span class="badge bg-danger">Baixo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>