@model BrasaBot.ViewModels.NovoDeliveryViewModel

@{
    ViewData["Title"] = "Novo Pedido - Delivery";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Novo Pedido - Delivery</h2>
        <small class="text-muted">Selecione o cliente.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<form asp-action="NovoDelivery" method="post" class="card p-4">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-12">
            <label class="form-label">Cliente</label>
            <select name="clienteId" asp-items="Model.Clientes" class="form-select" required>
                <option value="">-- Selecione --</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-dark">Confirmar</button>
    </div>
</form>