@model BrasaBot.Models.Insumo

@{
    ViewData["Title"] = "Visualizar Insumo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Visualizar Insumo</h2>
        <small class="text-muted">Gerencie os cadastros de insumos.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="card p-4">
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <input class="form-control" value="@Model.Id" disabled />
        </div>
        <div class="col-md-10">
            <label class="form-label">Nome</label>
            <input class="form-control" value="@Model.Nome" disabled />
        </div>

        <div class="col-md-4">
            <label class="form-label">Estoque Mínimo</label>
            <input class="form-control" value="@Model.EstoqueMinimo" disabled />
        </div>
        <div class="col-md-4">
            <label class="form-label">Unidade de Medida</label>
            <input class="form-control" value="@Model.UnidadeMedida" disabled />
        </div>
        <div class="col-md-4">
            <label class="form-label">Quantidade</label>
            <input class="form-control" value="@Model.EstoqueAtualQtd" disabled />
        </div>

        <div class="col-md-12 mt-3">
            <label class="form-label">Fornecedor</label>
            <input class="form-control" value="@(Model.Fornecedor?.Nome ?? "Não informado")" disabled />
        </div>
    </div>
</div>