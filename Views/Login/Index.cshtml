@model BrasaBot.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;  // Tela de login NÃO usa o layout padrão (sem menu)
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - BrasaBot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row vh-100">

            <!-- ÁREA ESQUERDA (verde) -->
            <div class="col-md-5 d-flex flex-column justify-content-center align-items-center"
                 style="background-color: #1B2E21;">
                <div class="text-center text-white">
                    <i class="bi bi-fire" style="font-size: 5rem;"></i>
                    <h1 class="mt-3 mb-0 fw-bold">BrasaBot</h1>
                    <p class="text-white-50 mt-2">Sistema de Gestão</p>
                </div>
            </div>

            <!-- ÁREA DIREITA (login) -->
            <div class="col-md-7 d-flex flex-column justify-content-center align-items-center bg-white">
                <div class="w-100" style="max-width: 420px;">
                    <h2 class="mb-2">Bem-vindo!</h2>
                    <p class="text-muted mb-4">Faça login para obter acesso.</p>

                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="seu@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" type="password" class="form-control" placeholder="********" />
                            <span asp-validation-for="Senha" class="text-danger"></span>
                        </div>

                        <div class="text-center mb-3">
                            <a href="#" class="text-decoration-none small" data-bs-toggle="modal" data-bs-target="#modalEsqueciSenha">
                                Esqueci minha senha
                            </a>
                        </div>

                        <button type="submit" class="btn w-100 text-white" style="background-color: #1B2E21;">
                            Login
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Modal Esqueci minha senha (RF16.8) -->
    <div class="modal fade" id="modalEsqueciSenha" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <p class="mb-0">Deseja redefinir sua senha? Ao confirmar a ação, será enviada uma notificação ao perfil administrador.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>