@model BrasaBot.ViewModels.FechamentoCaixaViewModel

@{
    ViewData["Title"] = "Fechamento de Caixa";
    var caixa = ViewBag.Caixa as BrasaBot.Models.Caixa;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Fechamento de Caixa</h2>
        <small class="text-muted">Informe o valor para fechar o Caixa.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row g-3">
    <!-- Painel esquerdo: info do caixa -->
    <div class="col-md-4">
        <div class="card p-3">
            @if (caixa != null)
            {
                <p class="small mb-1"><strong>Operador:</strong> @caixa.Funcionario?.Nome</p>
                <p class="small mb-1"><strong>Caixa:</strong> @caixa.NumeroCaixa.ToString("00")</p>
                <p class="small mb-1"><strong>Abertura:</strong> @caixa.DataAbertura.ToString("dd/MM/yyyy HH:mm")</p>
                <hr />
                <p class="small mb-1"><strong>Total Entradas:</strong> @caixa.TotalEntradas.ToString("C")</p>
                <p class="small mb-1"><strong>Total Saídas:</strong> @caixa.TotalSaidas.ToString("C")</p>
                <p class="small"><strong>Total Geral:</strong> @caixa.Total.ToString("C")</p>
            }
        </div>
    </div>

    <!-- Painel direito: formulário -->
    <div class="col-md-8">
        <form asp-action="Fechar" method="post" class="card p-4">
            <input type="hidden" asp-for="CaixaId" />

            <h6>Informe os valores conferidos por forma de pagamento:</h6>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label asp-for="ValorDinheiro" class="form-label"><i class="bi bi-cash"></i> Dinheiro</label>
                    <input asp-for="ValorDinheiro" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ValorCredito" class="form-label"><i class="bi bi-credit-card"></i> Crédito</label>
                    <input asp-for="ValorCredito" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ValorDebito" class="form-label"><i class="bi bi-credit-card-2-front"></i> Débito</label>
                    <input asp-for="ValorDebito" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ValorPix" class="form-label"><i class="bi bi-phone"></i> PIX</label>
                    <input asp-for="ValorPix" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Observacao" class="form-label"></label>
                    <textarea asp-for="Observacao" class="form-control" rows="2" placeholder="Informações adicionais sobre o caixa..."></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg"></i> Finalizar
                </button>
            </div>
        </form>
    </div>
</div>