@model BrasaBot.ViewModels.PerfilViewModel

@{
    ViewData["Title"] = "Meu Perfil";
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErroSenha"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErroSenha"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <h2 class="mb-0">Meu Perfil</h2>
    <small class="text-muted">Gerencie suas informações pessoais.</small>
</div>

<div class="row g-3">
    <!-- Área esquerda -->
    <div class="col-md-4">
        <div class="card p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.Foto))
            {
                <img src="@Model.Foto" alt="Foto" class="rounded-circle mx-auto mb-3"
                     style="width: 120px; height: 120px; object-fit: cover;" />
            }
            else
            {
                <i class="bi bi-person-circle text-secondary mb-3" style="font-size: 120px;"></i>
            }

            <h5 class="mb-0">@Model.Nome</h5>
            <p class="text-muted mb-1">Perfil @Model.NivelAcesso</p>
            <p class="text-muted small">@Model.Cargo</p>

            <div class="d-grid gap-2 mt-3">
                <a asp-action="Edit" class="btn btn-dark">
                    <i class="bi bi-pencil-square"></i> Editar Perfil
                </a>
                <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#modalAlterarSenha">
                    <i class="bi bi-key"></i> Alterar Senha
                </button>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalSair">
                    <i class="bi bi-box-arrow-right"></i> Sair
                </button>
            </div>
        </div>
    </div>

    <!-- Área direita -->
    <div class="col-md-8">
        <div class="card p-4">
            <h5 class="mb-3">Informações Pessoais</h5>

            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label">Nome</label>
                    <input class="form-control" value="@Model.Nome" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Telefone</label>
                    <input class="form-control" value="@Model.Telefone" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Cargo</label>
                    <input class="form-control" value="@Model.Cargo" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data de Admissão</label>
                    <input class="form-control" value="@Model.DataAdmissao.ToString("dd/MM/yyyy")" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Último acesso</label>
                    <input class="form-control"
                           value="@(Model.UltimoAcesso.HasValue? Model.UltimoAcesso.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca acessou")"
                           disabled />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Alterar Senha -->
<div class="modal fade" id="modalAlterarSenha" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AlterarSenha" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Alterar Senha</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Senha Atual</label>
                        <input type="password" name="SenhaAtual" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nova Senha</label>
                        <input type="password" name="NovaSenha" class="form-control" required minlength="6" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirmar Nova Senha</label>
                        <input type="password" name="ConfirmarNovaSenha" class="form-control" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sair -->
<div class="modal fade" id="modalSair" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <p class="mb-0">Deseja sair?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <form asp-action="Sair" method="post" class="d-inline">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>