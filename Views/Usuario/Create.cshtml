@model BrasaBot.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Cadastrar Usuário";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Cadastrar Usuário</h2>
        <small class="text-muted">Gerencie os cadastros de usuários.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Id</label>
            <input class="form-control" value="Auto" disabled />
        </div>
        <div class="col-md-7">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ArquivoFoto" class="form-label"></label>
            <input asp-for="ArquivoFoto" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
            <span asp-validation-for="ArquivoFoto" class="text-danger"></span>
            <small class="text-muted">JPG, JPEG ou PNG, máx. 2 MB.</small>
        </div>

        <div class="col-md-12">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" type="password" class="form-control" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <div class="col-md-12 mt-3">
            <label asp-for="FuncionarioId" class="form-label"></label>
            <select asp-for="FuncionarioId" asp-items="Model.Funcionarios" class="form-select">
                <option value="">-- Selecione uma opção --</option>
            </select>
            <span asp-validation-for="FuncionarioId" class="text-danger"></span>
        </div>

        <div class="col-md-6 mt-3">
            <label asp-for="NivelAcesso" class="form-label"></label>
            <select asp-for="NivelAcesso" class="form-select">
                <option value="">-- Selecione uma opção --</option>
                <option value="Administrador">Administrador</option>
                <option value="Básico">Básico</option>
            </select>
            <span asp-validation-for="NivelAcesso" class="text-danger"></span>
        </div>
        <div class="col-md-6 mt-3">
            <label asp-for="Ativo" class="form-label"></label>
            <select asp-for="Ativo" class="form-select">
                <option value="true">Sim</option>
                <option value="false">Não</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-dark">
            <i class="bi bi-check-lg"></i> Confirmar
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}